{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pmmg.qgpmmg.com.br"
        }
      ],
      "destination": "/pmmg/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pmmg.(?<domain>.*)"
        }
      ],
      "destination": "/pmmg/index.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "pmmg.qgpmmg.com.br"
        }
      ],
      "destination": "/pmmg/index.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "pmmg.(?<domain>.*)"
        }
      ],
      "destination": "/pmmg/index.html"
    }
  ]
}
